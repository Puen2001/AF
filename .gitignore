# config/ is deny-by-default: anything new dropped there stays out of git
config/*
!config/config.yaml
!config/secrets.env.example
!config/seed_products.yaml
factory.db
queue/
assets/cache/
__pycache__/
*.pyc
.DS_Store

# music beds are operator-supplied (licensing varies) — keep local
assets/music/*
!assets/music/.gitkeep
*.log

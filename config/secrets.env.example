# Copy to secrets.env (gitignored) and fill in. All services on this list are free.
TELEGRAM_BOT_TOKEN=            # fresh bot from @BotFather (keep separate from batcave alerts)
TELEGRAM_CHAT_ID=              # your chat id with that bot
SHOPEE_AFFILIATE_ID=           # from affiliate.shopee.co.th after signup
PEXELS_API_KEY=                # free at pexels.com/api — unlocks real b-roll footage
PIXABAY_API_KEY=               # free at pixabay.com/api/docs — b-roll fallback source
YOUTUBE_CLIENT_SECRET_JSON=    # path to OAuth client secret file (phase 3)
CLAUDE_CONFIG_DIR=             # optional: set if scriptgen should use a specific Claude account
